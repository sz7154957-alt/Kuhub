local function setupESPForPlayer(plr)
    local function applyESP(char)
        if not char then return end
        local hl = char:FindFirstChild("KStudioHighlight")
        if not hl then
            hl = Instance.new("Highlight")
            hl.Name = "KStudioHighlight"
            hl.FillTransparency = 0.5
            hl.OutlineTransparency = 0
            hl.Parent = char
        end
        hl.Enabled = getgenv().ESP_Highlight
    end
    if plr.Character then applyESP(plr.Character) end
    plr.CharacterAdded:Connect(function(newChar)
        task.wait(1)
        applyESP(newChar)
    end)
end

for _, p in pairs(Players:GetPlayers()) do
    if p ~= LocalPlayer then coroutine.wrap(setupESPForPlayer)(p) end
end
Players.PlayerAdded:Connect(function(p)
    if p ~= LocalPlayer then coroutine.wrap(setupESPForPlayer)(p) end
end)

