local function updateLanguage()
    title.Text = langText[currentLang].title
    for _, btn in pairs(tabButtons) do if langText[currentLang][btn.Name] then btn.Text = langText[currentLang][btn.Name] end end
    for _, item in pairs(translatableTexts) do 
        if item.Obj and item.Obj.Parent and langText[currentLang][item.Key] then 
            if item.Extra then
                item.Obj.Text = langText[currentLang][item.Key] .. item.Extra
            else
                item.Obj.Text = langText[currentLang][item.Key] 
            end
        end 
    end
end

