-- [[ ระบบล็อคมุมกล้อง (Camera Lock Toggle) ]]
getgenv().CameraLockActive = false
local camPosition = Camera.CFrame.Position
local camRotation = Camera.CFrame - Camera.CFrame.Position
local camSpeed = 50
local inputKeys = {W = false, A = false, S = false, D = false, Space = false, Ctrl = false}

createToggle(page_clip, "camLockToggle", function(state)
    getgenv().CameraLockActive = state
    if state then
        camPosition = Camera.CFrame.Position
        camRotation = Camera.CFrame - Camera.CFrame.Position
        Camera.CameraType = Enum.CameraType.Scriptable
    else
        Camera.CameraType = Enum.CameraType.Custom
        if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid") then
            Camera.CameraSubject = LocalPlayer.Character.Humanoid
        end
    end
end)

UserInputService.InputBegan:Connect(function(input)
    if not getgenv().CameraLockActive then return end
    if input.KeyCode == Enum.KeyCode.W then inputKeys.W = true end
    if input.KeyCode == Enum.KeyCode.A then inputKeys.A = true end
    if input.KeyCode == Enum.KeyCode.S then inputKeys.S = true end
    if input.KeyCode == Enum.KeyCode.D then inputKeys.D = true end
    if input.KeyCode == Enum.KeyCode.Space then inputKeys.Space = true end
    if input.KeyCode == Enum.KeyCode.LeftControl then inputKeys.Ctrl = true end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.KeyCode == Enum.KeyCode.W then inputKeys.W = false end
    if input.KeyCode == Enum.KeyCode.A then inputKeys.A = false end
    if input.KeyCode == Enum.KeyCode.S then inputKeys.S = false end
    if input.KeyCode == Enum.KeyCode.D then inputKeys.D = false end
    if input.KeyCode == Enum.KeyCode.Space then inputKeys.Space = false end
    if input.KeyCode == Enum.KeyCode.LeftControl then inputKeys.Ctrl = false end
end)

UserInputService.InputChanged:Connect(function(input)
    if getgenv().CameraLockActive and input.UserInputType == Enum.UserInputType.MouseMovement then
        local delta = input.Delta
        camRotation = camRotation * CFrame.Angles(0, -delta.X * 0.003, 0)
        camRotation = CFrame.Angles(-delta.Y * 0.003, 0, 0) * camRotation
    end
end)

RunService.RenderStepped:Connect(function(dt)
    if getgenv().CameraLockActive then
        local moveDir = Vector3.new()
        if inputKeys.W then moveDir = moveDir + Vector3.new(0, 0, -1) end
        if inputKeys.S then moveDir = moveDir + Vector3.new(0, 0, 1) end
        if inputKeys.A then moveDir = moveDir + Vector3.new(-1, 0, 0) end
        if inputKeys.D then moveDir = moveDir + Vector3.new(1, 0, 0) end
        if inputKeys.Space then moveDir = moveDir + Vector3.new(0, 1, 0) end
        if inputKeys.Ctrl then moveDir = moveDir + Vector3.new(0, -1, 0) end
        
        camPosition = camPosition + (camRotation:VectorToWorldSpace(moveDir) * camSpeed * dt)
        local targetCFrame = CFrame.new(camPosition) * camRotation
        Camera.CFrame = Camera.CFrame:Lerp(targetCFrame, 0.35)
    end
end)

