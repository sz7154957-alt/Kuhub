local isOpen = false
local function toggleUI()
    isOpen = not isOpen
    local currentTrans = mainFrame:GetAttribute("UIBlur") and 0.15 or 0
    if isOpen then
        mainFrame.Visible = true
        TweenService:Create(mainFrame, TweenInfo.new(0.35, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
            Size = UDim2.new(0, 520, 0, 320),
            BackgroundTransparency = currentTrans
        }):Play()
        TweenService:Create(mainStroke, TweenInfo.new(0.35, Enum.EasingStyle.Sine, Enum.EasingDirection.Out), {Transparency = 0}):Play()
    else
        TweenService:Create(mainFrame, TweenInfo.new(0.25, Enum.EasingStyle.Quart, Enum.EasingDirection.In), {
            Size = UDim2.new(0, 0, 0, 0),
            BackgroundTransparency = 1
        }):Play()
        local strokeTween = TweenService:Create(mainStroke, TweenInfo.new(0.25), {Transparency = 1})
        strokeTween:Play()
        strokeTween.Completed:Connect(function()
            if not isOpen then mainFrame.Visible = false end
        end)
    end
end

